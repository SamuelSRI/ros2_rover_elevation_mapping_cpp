<?xml version="1.0"?>
<package format="3">
  <name>ros2_rover_elevation_mapping_cpp</name>
  <version>0.0.2</version>
  <description>ROS 2 C++ traversability mapping with PCL normals, obstacle height and LiDAR ray tracing.</description>

  <maintainer email="samuel@example.com">Samuel Gendre</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
